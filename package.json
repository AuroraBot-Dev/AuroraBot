{
  "name": "aurorabot",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "AuroraBot 的 Python 运行时与 Vue 应用工作区",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter aurorabot-landing dev",
    "dev:docs": "pnpm --filter aurorabot-docs dev",
    "dev:panel": "pnpm --filter aurorabot-panel dev",
    "dev:landing": "pnpm --filter aurorabot-landing dev",
    "build": "pnpm build:docs && pnpm build:panel && pnpm build:landing",
    "build:docs": "pnpm --filter aurorabot-docs build",
    "build:panel": "pnpm --filter aurorabot-panel build",
    "build:landing": "pnpm --filter aurorabot-landing build",
    "preview:docs": "pnpm --filter aurorabot-docs preview",
    "preview:panel": "pnpm --filter aurorabot-panel preview",
    "preview:landing": "pnpm --filter aurorabot-landing preview",
    "typecheck": "pnpm typecheck:scripts && pnpm --filter aurorabot-docs --filter aurorabot-panel --filter aurorabot-landing typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "pnpm lint:workspace && pnpm lint:panel",
    "test": "pnpm --filter aurorabot-panel test:unit",
    "check": "pnpm check:python && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:python": "uv run aurora check",
    "postinstall": "pnpm -r --if-present run stub",
    "clean": "tsx scripts/clean.mts",
    "lint:workspace": "prettier --check package.json pnpm-workspace.yaml turbo.json tsconfig.scripts.json \"scripts/**/*.mts\" \"apps/landing/*.{json,html,ts,md}\" \"apps/landing/src/**/*.{ts,vue,css,json}\" .github/workflows/apps.yml",
    "lint:panel": "pnpm --filter aurorabot-panel lint",
    "format": "prettier --write package.json pnpm-workspace.yaml turbo.json tsconfig.scripts.json \"scripts/**/*.mts\" \"apps/landing/*.{json,html,ts,md}\" \"apps/landing/src/**/*.{ts,vue,css,json}\" .github/workflows/apps.yml"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "tsx": "catalog:"
  }
}
