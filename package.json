{
  "name": "aurorabot",
  "version": "0.7.0",
  "description": "AuroraBot 的 Python 运行时与 Vue 应用工作区",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @aurorabot/landing dev",
    "dev:docs": "pnpm --filter @aurorabot/docsite dev",
    "dev:panel": "pnpm --filter @aurorabot/panel dev",
    "dev:landing": "pnpm --filter @aurorabot/landing dev",
    "build": "pnpm build:docs && pnpm build:panel && pnpm build:landing",
    "build:docs": "pnpm --filter @aurorabot/docsite build",
    "build:panel": "pnpm --filter @aurorabot/panel build",
    "build:landing": "pnpm --filter @aurorabot/landing build",
    "preview:docs": "pnpm --filter @aurorabot/docsite preview",
    "preview:panel": "pnpm --filter @aurorabot/panel preview",
    "preview:landing": "pnpm --filter @aurorabot/landing preview",
    "typecheck": "pnpm typecheck:config && pnpm -r --if-present typecheck",
    "lint": "pnpm lint:format && pnpm lint:oxlint && pnpm lint:eslint && pnpm lint:style",
    "test": "vitest run",
    "check": "pnpm check:python && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:python": "uv run aurora check",
    "postinstall": "pnpm -r --if-present run stub",
    "clean": "tsx scripts/clean.mts",
    "format": "pnpm lint:oxlint --fix && pnpm lint:eslint --fix && pnpm lint:style --fix && prettier --write \"apps/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"packages/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"tooling/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"scripts/**/*.mts\" \"*.{ts,json,yaml}\" .github/workflows/apps.yml .github/workflows/deploy-docs.yml",
    "typecheck:config": "tsc -p tsconfig.json",
    "lint:format": "prettier --check \"apps/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"packages/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"tooling/**/*.{ts,tsx,vue,css,scss,json,mjs}\" \"scripts/**/*.mts\" \"*.{ts,json,yaml}\" .github/workflows/apps.yml .github/workflows/deploy-docs.yml",
    "lint:oxlint": "oxlint --type-aware --threads=4 apps packages tooling scripts *.config.ts",
    "lint:eslint": "eslint apps packages tooling scripts *.config.ts package.json pnpm-workspace.yaml tsconfig.json --cache",
    "lint:style": "stylelint \"apps/**/*.{vue,css,scss}\" \"packages/**/*.{vue,css,scss}\" \"tooling/**/*.{vue,css,scss}\" --cache",
    "test:panel": "vitest run apps/panel"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "jiti": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.11.2"
}
