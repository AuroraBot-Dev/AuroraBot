{
  "schema_version": 2,
  "distribution": {
    "name": "aurora-cli",
    "version": "0.1.0",
    "description": "AuroraBot command-line interface",
    "requires-python": ">=3.12",
    "dependencies": [
      "aurora-host>=0.1.0",
      "aurora-core>=0.1.0",
      "aurora-config>=0.1.0",
      "aurora-api>=0.1.0",
      "aurora-logging>=0.1.0",
      "rich>=14,<15",
      "tomlkit>=0.13,<1"
    ],
    "scripts": {
      "aurora": "aurora_cli.main:main"
    }
  },
  "manifests": {
    "src/aurora_cli/plugin.meta.toml": {
      "schema_version": 2,
      "host": {
        "name": "aurora_cli",
        "title": "CLI 宿主目录",
        "summary": "内置命令、命令接收方与交互配置；命令实现由 CLI 装载"
      },
      "definitions": {
        "COMMANDS": {
          "id": "org.aurora.cli:registries/commands",
          "kind": "registry",
          "summary": "CLI registries/commands",
          "register_to": {
            "id": "org.aurora.core:registries/registries"
          }
        },
        "COMMAND_SCHEMA": {
          "id": "org.aurora.cli:schemas/command",
          "kind": "schema",
          "summary": "CLI schemas/command",
          "register_to": {
            "id": "org.aurora.core:registries/schemas"
          }
        },
        "CONFIGURATION": {
          "id": "org.aurora.cli:configs/default",
          "kind": "config",
          "summary": "CLI configs/default",
          "register_to": {
            "id": "org.aurora.config:registries/configs"
          }
        },
        "CONFIG": {
          "id": "org.aurora.cli:state/config",
          "kind": "state_key",
          "summary": "CLI state/config",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "CMD_ABOUT": {
          "id": "org.aurora.cli:commands/about",
          "kind": "command",
          "summary": "了解 AuroraBot 与当前运行环境",
          "provider": "aurora_cli.commands.about",
          "contract": "about",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CHECK": {
          "id": "org.aurora.cli:commands/check",
          "kind": "command",
          "summary": "默认运行静态检查与快速边界测试；--full 运行完整测试，--coverage 统计完整覆盖率",
          "provider": "aurora_cli.commands.check",
          "contract": "check",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CTX_GET": {
          "id": "org.aurora.cli:commands/ctx/get",
          "kind": "command",
          "summary": "读取精确状态地址",
          "provider": "aurora_cli.commands.ctx",
          "contract": "ctx_get",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CTX_SET": {
          "id": "org.aurora.cli:commands/ctx/set",
          "kind": "command",
          "summary": "以 JSON 整项替换状态",
          "provider": "aurora_cli.commands.ctx",
          "contract": "ctx_set",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CTX_DELETE": {
          "id": "org.aurora.cli:commands/ctx/delete",
          "kind": "command",
          "summary": "删除精确状态地址",
          "provider": "aurora_cli.commands.ctx",
          "contract": "ctx_delete",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CTX_LIST": {
          "id": "org.aurora.cli:commands/ctx/list",
          "kind": "command",
          "summary": "枚举已赋值地址",
          "provider": "aurora_cli.commands.ctx",
          "contract": "ctx_list",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_CTX_WATCH": {
          "id": "org.aurora.cli:commands/ctx/watch",
          "kind": "command",
          "summary": "观察当前宿主后续变化，Ctrl+C 退出",
          "provider": "aurora_cli.commands.ctx",
          "contract": "ctx_watch",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_DONK_SHOW": {
          "id": "org.aurora.cli:commands/donk/show",
          "kind": "command",
          "summary": "显示 Python 工作区版本",
          "provider": "aurora_cli.commands.donk",
          "contract": "donk_show",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_DONK_MAJOR": {
          "id": "org.aurora.cli:commands/donk/major",
          "kind": "command",
          "summary": "升级主版本号",
          "provider": "aurora_cli.commands.donk",
          "contract": "donk_major",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_DONK_MINOR": {
          "id": "org.aurora.cli:commands/donk/minor",
          "kind": "command",
          "summary": "升级次版本号",
          "provider": "aurora_cli.commands.donk",
          "contract": "donk_minor",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_DONK_PATCH": {
          "id": "org.aurora.cli:commands/donk/patch",
          "kind": "command",
          "summary": "升级修订版本号",
          "provider": "aurora_cli.commands.donk",
          "contract": "donk_patch",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_HELP": {
          "id": "org.aurora.cli:commands/help",
          "kind": "command",
          "summary": "列出当前可用命令",
          "provider": "aurora_cli.commands.help",
          "contract": "help",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_ID_LIST": {
          "id": "org.aurora.cli:commands/id/list",
          "kind": "command",
          "summary": "列出启动前已登记的公共 ID、类型和提供者，不启动装配",
          "provider": "aurora_cli.commands.id",
          "contract": "id_list",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_BOT": {
          "id": "org.aurora.cli:commands/bot",
          "kind": "command",
          "summary": "快速启动完整 Bot 后端，读取项目 .env 与 data",
          "provider": "aurora_cli.commands.launch",
          "contract": "bot",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_PANEL": {
          "id": "org.aurora.cli:commands/panel",
          "kind": "command",
          "summary": "快速启动 Panel 开发服务器，连接已有后端",
          "provider": "aurora_cli.commands.launch",
          "contract": "panel",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_TUI": {
          "id": "org.aurora.cli:commands/tui",
          "kind": "command",
          "summary": "快速启动 TUI，使用项目 .env 中的访问令牌",
          "provider": "aurora_cli.commands.launch",
          "contract": "tui",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_RUN": {
          "id": "org.aurora.cli:commands/run",
          "kind": "command",
          "summary": "启动选定装配，Ctrl+C 停止",
          "provider": "aurora_cli.commands.run",
          "contract": "run",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        },
        "CMD_SERVE": {
          "id": "org.aurora.cli:commands/serve",
          "kind": "command",
          "summary": "启动本机 API；keys 为开放状态 ID 数组（默认 CLI config），endpoints 为显式开放的产品端点 ID 数组",
          "provider": "aurora_cli.commands.serve",
          "contract": "serve",
          "register_to": {
            "id": "org.aurora.cli:registries/commands"
          }
        }
      },
      "contracts": {
        "about": {
          "format": "json",
          "file": "contracts/about.json",
          "content": {
            "help": "了解 AuroraBot 与当前运行环境"
          }
        },
        "check": {
          "format": "json",
          "file": "contracts/check.json",
          "content": {
            "help": "默认运行静态检查与快速边界测试；--full 运行完整测试，--coverage 统计完整覆盖率",
            "arguments": [
              {
                "name": "lint",
                "type": "flag",
                "option": true
              },
              {
                "name": "test",
                "type": "flag",
                "option": true
              },
              {
                "name": "full",
                "type": "flag",
                "option": true
              },
              {
                "name": "coverage",
                "type": "flag",
                "option": true
              },
              {
                "name": "fix",
                "type": "flag",
                "option": true
              },
              {
                "name": "unsafe_fixes",
                "type": "flag",
                "option": true
              },
              {
                "name": "check",
                "type": "flag",
                "option": true
              }
            ]
          }
        },
        "ctx_get": {
          "format": "json",
          "file": "contracts/ctx_get.json",
          "content": {
            "help": "读取精确状态地址",
            "arguments": [
              {
                "name": "key",
                "type": "id"
              },
              {
                "name": "location",
                "type": "location",
                "option": true
              }
            ],
            "operation": "org.aurora.core:operations/ctx/get"
          }
        },
        "ctx_set": {
          "format": "json",
          "file": "contracts/ctx_set.json",
          "content": {
            "help": "以 JSON 整项替换状态",
            "arguments": [
              {
                "name": "key",
                "type": "id"
              },
              {
                "name": "value",
                "type": "json"
              },
              {
                "name": "location",
                "type": "location",
                "option": true
              }
            ],
            "operation": "org.aurora.core:operations/ctx/set"
          }
        },
        "ctx_delete": {
          "format": "json",
          "file": "contracts/ctx_delete.json",
          "content": {
            "help": "删除精确状态地址",
            "arguments": [
              {
                "name": "key",
                "type": "id"
              },
              {
                "name": "location",
                "type": "location",
                "option": true
              }
            ],
            "operation": "org.aurora.core:operations/ctx/delete"
          }
        },
        "ctx_list": {
          "format": "json",
          "file": "contracts/ctx_list.json",
          "content": {
            "help": "枚举已赋值地址",
            "arguments": [
              {
                "name": "key",
                "type": "id",
                "option": true
              },
              {
                "name": "location",
                "type": "location",
                "option": true
              }
            ],
            "runtime": true
          }
        },
        "ctx_watch": {
          "format": "json",
          "file": "contracts/ctx_watch.json",
          "content": {
            "help": "观察当前宿主后续变化，Ctrl+C 退出",
            "arguments": [
              {
                "name": "key",
                "type": "id",
                "option": true
              },
              {
                "name": "location",
                "type": "location",
                "option": true
              }
            ],
            "runtime": true
          }
        },
        "donk_show": {
          "format": "json",
          "file": "contracts/donk_show.json",
          "content": {
            "help": "显示 Python 工作区版本"
          }
        },
        "donk_major": {
          "format": "json",
          "file": "contracts/donk_major.json",
          "content": {
            "help": "升级主版本号"
          }
        },
        "donk_minor": {
          "format": "json",
          "file": "contracts/donk_minor.json",
          "content": {
            "help": "升级次版本号"
          }
        },
        "donk_patch": {
          "format": "json",
          "file": "contracts/donk_patch.json",
          "content": {
            "help": "升级修订版本号"
          }
        },
        "help": {
          "format": "json",
          "file": "contracts/help.json",
          "content": {
            "help": "列出当前可用命令"
          }
        },
        "id_list": {
          "format": "json",
          "file": "contracts/id_list.json",
          "content": {
            "help": "列出启动前已登记的公共 ID、类型和提供者，不启动装配"
          }
        },
        "bot": {
          "format": "json",
          "file": "contracts/bot.json",
          "content": {
            "help": "快速启动完整 Bot 后端，读取项目 .env 与 data",
            "passthrough": "参数原样交给 scripts/bot.py；无参数使用项目默认配置"
          }
        },
        "panel": {
          "format": "json",
          "file": "contracts/panel.json",
          "content": {
            "help": "快速启动 Panel 开发服务器，连接已有后端",
            "passthrough": "参数原样交给 scripts/panel.py；无参数使用项目默认配置"
          }
        },
        "tui": {
          "format": "json",
          "file": "contracts/tui.json",
          "content": {
            "help": "快速启动 TUI，使用项目 .env 中的访问令牌",
            "passthrough": "参数原样交给 scripts/tui.py；无参数使用项目默认配置"
          }
        },
        "run": {
          "format": "json",
          "file": "contracts/run.json",
          "content": {
            "help": "启动选定装配，Ctrl+C 停止",
            "runtime": true
          }
        },
        "serve": {
          "format": "json",
          "file": "contracts/serve.json",
          "content": {
            "help": "启动本机 API；keys 为开放状态 ID 数组（默认 CLI config），endpoints 为显式开放的产品端点 ID 数组",
            "runtime": true,
            "arguments": [
              {
                "name": "port",
                "type": "integer",
                "option": true
              },
              {
                "name": "keys",
                "type": "json",
                "option": true
              },
              {
                "name": "read_only_keys",
                "type": "json",
                "option": true
              },
              {
                "name": "endpoints",
                "type": "json",
                "option": true
              },
              {
                "name": "token_env",
                "type": "string",
                "option": true
              },
              {
                "name": "allowed_origins",
                "type": "json",
                "option": true
              },
              {
                "name": "allowed_hosts",
                "type": "json",
                "option": true
              }
            ]
          }
        }
      }
    }
  }
}
