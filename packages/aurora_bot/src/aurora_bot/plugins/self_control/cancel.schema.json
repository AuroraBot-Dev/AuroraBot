{
  "name": "wake_cancel",
  "description": "按当前 revision 取消未提交计划。uncertain 仅停止后续投递，不撤销可能已接纳的引导；先核对外部结果。",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "wake_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
        "maxLength": 64
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": ["wake_id", "expected_revision"]
  }
}
