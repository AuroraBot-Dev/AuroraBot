          "plugin": "self_control",
          "id": "org.aurora.bot:tools/self_control/cancel",
          "kind": "tool",
          "summary": "显式选择的工具",
          "contract": "cancel",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        },
        "PREPARE": {
          "plugin": "self_control",
          "id": "org.aurora.bot:handlers/self_control/prepare",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "START": {
          "plugin": "self_control",
          "id": "org.aurora.bot:handlers/self_control/start",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "CLEAN": {
          "plugin": "self_control",
          "id": "org.aurora.bot:handlers/self_control/clean",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        }
      },
      "components": {
        "control": {
          "inject": ["ctx", "options"],
          "plugs": ["PREPARE", "START", "CLEAN"],
          "slots": [],
          "states": [],
          "optional_states": [],
          "inputs": ["runtime", "agent"],
          "optional_inputs": [],
          "resources": ["control"],
          "options": "owner",
          "plugin": "self_control"
        }
      },
      "contracts": {
        "status": {
          "format": "json",
          "file": "status.schema.json",
          "content": {
            "name": "bot_status",
            "description": "读取自己的运行、自动引导开关、计划数量、下次唤醒及当前 UTC 时间。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        "autonomy": {
          "format": "json",
          "file": "autonomy.schema.json",
          "content": {
            "name": "bot_autonomy",
            "description": "设置 paused。暂停普通 cadence 和计划唤醒，保留计划且直接交流仍可用；false 恢复。不会结束当前运行或清除故障。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "paused": {
                  "type": "boolean"
                }
              },
              "required": ["paused"]
            }
          }
        },
        "finish": {
          "format": "json",
          "file": "finish.schema.json",
          "content": {
            "name": "bot_finish",
            "description": "请求本轮全部工具和结果观察完成后正常结束，不再推理。应放在本批最后；不取消其他工具或新输入，不暂停自动引导。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        "schedule": {
          "format": "json",
          "file": "schedule.schema.json",
          "content": {
            "name": "wake_schedule",
            "description": "创建或更新一次性唤醒。用 delay_seconds 或带时区的 ISO 时间 at，二选一，最多30天后。late_seconds 为迟到有效期，默认3600秒；过期不补发。创建 expected_revision=0，更新先查询版本。仅提交未来引导，不重试旧工具。工具成功表示已写入 ctx，宿主异步落盘。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "wake_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "delay_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2592000
                },
                "at": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "late_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 86400
                }
              },
              "required": ["wake_id", "expected_revision", "text"],
              "oneOf": [
                {
                  "required": ["delay_seconds"]
                },
                {
                  "required": ["at"]
                }
              ]
            }
          }
        },
        "list": {
          "format": "json",
          "file": "list.schema.json",
          "content": {
            "name": "wake_list",
            "description": "分页读取自己的完整唤醒计划和投递回执。uncertain 须核对，不能据缺失回执推断未执行或自动重试。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "after": {
                  "type": "string",
                  "maxLength": 64
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": []
            }
          }
        },
        "cancel": {
          "format": "json",
          "file": "cancel.schema.json",
          "content": {
            "name": "wake_cancel",
            "description": "按当前 revision 取消未提交计划。uncertain 仅停止后续投递，不撤销可能已接纳的引导；先核对外部结果。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "wake_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": ["wake_id", "expected_revision"]
            }
          }
        },
        "owner": {
          "format": "json-schema",
          "file": "owner.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner"],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
