    "src/aurora_bot/plugins/notes/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "notes": {
          "entry_point": "aurora_bot.notes",
          "title": "工作笔记",
          "summary": "导出本能力的定义、端口和资源，由宿主显式装配",
          "requires": ["aurora_tools"],
          "factory": "aurora_bot.work_notes:plugin"
        }
      },
      "definitions": {
        "NOTES": {
          "plugin": "notes",
          "id": "org.aurora.bot:state/notes",
          "kind": "state_key",
          "summary": "本能力持有的状态"
        },
        "COMPONENT": {
          "plugin": "notes",
          "id": "org.aurora.bot:components/notes",
          "kind": "component",
          "summary": "工具执行组件"
        },
        "EXECUTE": {
          "plugin": "notes",
          "id": "org.aurora.bot:components/notes/execute",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          },
          "interface": {
            "definition": {
              "id": "org.aurora.bot:components/notes"
            }
          }
        },
        "WRITE": {
          "plugin": "notes",
          "id": "org.aurora.bot:tools/notes/write",
          "kind": "tool",
          "summary": "显式选择的工具",
          "contract": "write",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        },
        "READ": {
          "plugin": "notes",
          "id": "org.aurora.bot:tools/notes/read",
          "kind": "tool",
          "summary": "显式选择的工具",
          "contract": "read",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        },
        "LIST": {
          "plugin": "notes",
          "id": "org.aurora.bot:tools/notes/list",
          "kind": "tool",
          "summary": "显式选择的工具",
          "contract": "list",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        }
      },
      "components": {
        "notes": {
          "inject": ["ctx", "options"],
          "plugs": [],
          "slots": [],
          "states": [],
          "optional_states": [],
          "inputs": [],
          "optional_inputs": [],
          "resources": ["notes"],
          "options": "owner",
          "plugin": "notes"
        }
      },
      "contracts": {
        "write": {
          "format": "json",
          "file": "write.schema.json",
          "content": {
            "name": "notes_write",
            "description": "创建或更新自己的工作笔记。创建时 expected_revision=0，更新须携带读取到的版本；笔记和引用不证明外部动作成功。",
            "parameters": {
              "type": "object",
              "properties": {
                "note_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "archived"]
                },
                "references": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "journal_id", "record_id"],
                        "properties": {
                          "kind": {
                            "const": "world_event"
                          },
                          "journal_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "record_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "run_id", "call_id"],
                        "properties": {
                          "kind": {
                            "const": "tool_call"
                          },
                          "run_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "call_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": ["note_id", "expected_revision", "text", "status", "references"],
              "additionalProperties": false
            }
          }
        },
        "read": {
          "format": "json",
          "file": "read.schema.json",
          "content": {
            "name": "notes_read",
            "description": "按 note_id 读取自己的完整笔记，包括已归档笔记。",
            "parameters": {
              "type": "object",
              "properties": {
                "note_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                  "maxLength": 64
                }
              },
              "required": ["note_id"],
              "additionalProperties": false
            }
          }
        },
        "list": {
          "format": "json",
          "file": "list.schema.json",
          "content": {
            "name": "notes_list",
            "description": "分页列出自己的笔记摘要；默认 active，status=all 包含归档。next_after 用于下一页，全文使用 notes_read。",
            "parameters": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["active", "archived", "all"]
                },
                "after": {
                  "type": "string",
                  "maxLength": 64
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [],
              "additionalProperties": false
            }
          }
        },
        "owner": {
          "format": "json-schema",
          "file": "owner.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner"],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "src/aurora_bot/plugins/actions/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "actions": {
          "entry_point": "aurora_bot.actions",
          "title": "行动证据",
          "summary": "导出本能力的定义、端口和资源，由宿主显式装配",
          "requires": ["aurora_tools", "aurora_config"],
          "factory": "aurora_bot.action_evidence:plugin"
        }
      },
      "definitions": {
        "COMPONENT": {
          "plugin": "actions",
          "id": "org.aurora.bot:components/actions/read",
          "kind": "component",
          "summary": "工具执行组件"
        },
        "EXECUTE": {
          "plugin": "actions",
          "id": "org.aurora.bot:components/actions/read/execute",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          },
          "interface": {
            "definition": {
              "id": "org.aurora.bot:components/actions/read"
            }
          }
        },
        "READ_ACTION": {
          "plugin": "actions",
          "id": "org.aurora.bot:tools/actions/read",
          "kind": "tool",
          "summary": "显式选择的工具",
          "contract": "read_action",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        },
        "PREPARE": {
          "plugin": "actions",
          "id": "org.aurora.bot:handlers/actions/prepare",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "CLEAN": {
          "plugin": "actions",
          "id": "org.aurora.bot:handlers/actions/clean",
          "kind": "hook_handler",
          "summary": "公开方法插头",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "CONFIGURATION": {
          "plugin": "actions",
          "id": "org.aurora.bot:configs/actions",
          "kind": "config",
          "summary": "业务参数配置",
          "contract": "config",
          "register_to": {
            "id": "org.aurora.config:registries/configs"
          }
        },
        "CONFIG_STATE": {
          "plugin": "actions",
          "id": "org.aurora.bot:state/actions/config",
          "kind": "state_key",
          "summary": "本能力持有的状态",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        }
      },
      "components": {
        "actions": {
          "inject": ["ctx", "storage", "states", "options"],
          "plugs": ["PREPARE", "CLEAN"],
          "slots": [],
          "states": [],
          "optional_states": ["config", "observation_config"],
          "inputs": [],
          "optional_inputs": [],
          "resources": ["evidence", "observation"],
          "options": "owner",
          "plugin": "actions"
        }
      },
      "contracts": {
        "read_action": {
          "format": "json",
          "file": "read_action.schema.json",
          "content": {
            "name": "actions_read",
            "description": "按 tool_call 引用的 run_id/call_id 查询本实例执行证据。offset 初始为 0，按 next_offset 分页至 null 后拼接 text 得到 JSON。completed/failed 仅代表工具返回，unknown 须核实；缺失不证明未执行，笔记不覆盖证据，读取不重试动作。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "call_id"],
              "properties": {
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "call_id": {
                  "type": "string",
                  "minLength": 1
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775806
                }
              }
            }
          }
        },
        "owner": {
          "format": "json-schema",
          "file": "owner.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner"],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "config": {
          "format": "json-schema",
          "file": "config.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_chars": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 32000,
                "default": 8000
              }
            }
          }
        }
      }
    },
