          "inputs": [],
          "optional_inputs": ["records", "notes", "actions", "archive"],
          "resources": ["view"],
          "plugin": "world_view",
          "options": "options"
        },
        "archive": {
          "inject": ["ctx", "states"],
          "plugs": [],
          "slots": [],
          "states": [],
          "optional_states": ["config"],
          "inputs": ["records"],
          "optional_inputs": [],
          "resources": ["archive"],
          "plugin": "world_view"
        }
      },
      "contracts": {
        "read_event": {
          "format": "json",
          "file": "read_event.schema.json",
          "content": {
            "name": "world_read_event",
            "description": "按 world_event 引用的 journal_id/record_id 读取当前 world 的原始事件 JSON。offset 初始为 0，按 next_offset 继续；仅当 next_offset=null 才读至末尾，拼接各页 text 后才是完整 JSON。只读，不重放事件，不代表事项已完成；不支持环境观察或 tool_call 引用。",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["journal_id", "record_id"],
              "properties": {
                "journal_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S"
                },
                "record_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775806,
                  "default": 0
                }
              }
            }
          }
        },
        "config": {
          "format": "json-schema",
          "export": "aurora_bot.plugins.world_view.parameters:schema",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_chars": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 128000,
                "default": 12000
              },
              "archive_max_chars": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 32000,
                "default": 8000
              },
              "events": {
                "type": "boolean",
                "default": true
              },
              "environment": {
                "type": "boolean",
                "default": true
              },
              "notes": {
                "type": "boolean",
                "default": true
              },
              "actions": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "options": {
          "format": "json-schema",
          "export": "aurora_bot.plugins.world_view.parameters:options",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_chars": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 128000
              },
              "archive_max_chars": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 32000
              },
              "events": {
                "type": "boolean"
              },
              "environment": {
                "type": "boolean"
              },
              "notes": {
                "type": "boolean"
              },
              "actions": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
