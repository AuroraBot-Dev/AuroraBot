{
  "schema_version": 2,
  "distribution": {
    "name": "aurora-bot",
    "version": "0.1.0",
    "description": "AuroraBot default composition and plugins",
    "requires-python": ">=3.12",
    "dependencies": [
      "aurora-agent>=0.1.0",
      "aurora-tools>=0.1.0",
      "aurora-host>=0.1.0",
      "aurora-core>=0.1.0",
      "aurora-config>=0.1.0",
      "aurora-control>=0.1.0",
      "aurora-model[config]>=0.1.0"
    ],
    "optional-dependencies": {
      "world": ["aurora-world[config]>=0.1.0"],
      "litellm": ["aurora-model[litellm]>=0.1.0"],
      "memory": ["aurora-memory>=0.1.0"],
      "mcp": ["aurora-mcp[tools]>=0.1.0", "tomli-w>=1.2,<2"],
      "mcp-world": ["aurora-mcp[tools,world]>=0.1.0", "tomli-w>=1.2,<2"]
    },
    "entry-points": {
      "aurora.plugins": {
        "aurora_bot.runtime": "aurora_bot.runtime:plugin",
        "aurora_bot.conversation": "aurora_bot.conversation:plugin",
        "aurora_bot.commands": "aurora_bot.cli:plugin",
        "aurora_bot.notes": "aurora_bot.work_notes:plugin",
        "aurora_bot.actions": "aurora_bot.action_evidence:plugin",
        "aurora_bot.self_control": "aurora_bot.self_control:plugin",
        "aurora_bot.world_view": "aurora_bot.context_view:plugin",
        "aurora_bot.cadence": "aurora_bot.cadence:plugin"
      }
    }
  },
  "manifests": {
    "src/aurora_bot/plugins/runtime/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "runtime": {
          "entry_point": "aurora_bot.runtime",
          "title": "运行所有者",
          "summary": "导出本能力的定义、端口和资源，由宿主显式装配",
          "requires": ["aurora_agent.react"],
          "factory": "aurora_bot.runtime:plugin"
        }
      },
      "definitions": {
        "RUN_CONTROL": {
          "plugin": "runtime",
          "id": "org.aurora.bot:services/run_control",
          "kind": "service",
          "summary": "按产品实例定位运行管理器",
          "register_to": {
            "id": "org.aurora.core:registries/services"
          }
        },
        "RUN_SUBMIT": {
          "plugin": "runtime",
          "id": "org.aurora.bot:operations/run/submit",
          "kind": "operation",
          "summary": "向实例提交引导并返回运行回执",
          "register_to": {
            "id": "org.aurora.core:registries/operations"
          }
        },
        "RUN_ACTIVATE": {
          "plugin": "runtime",
          "id": "org.aurora.bot:operations/run/activate",
          "kind": "operation",
          "summary": "显式激活实例",
          "register_to": {
            "id": "org.aurora.core:registries/operations"
          }
        },
        "RUN_CANCEL": {
          "plugin": "runtime",
          "id": "org.aurora.bot:operations/run/cancel",
          "kind": "operation",
          "summary": "取消匹配运行并等待收尾",
          "register_to": {
            "id": "org.aurora.core:registries/operations"
          }
        },
        "AGENTS": {
          "plugin": "runtime",
          "id": "org.aurora.bot:state/agents",
          "kind": "state_key",
          "summary": "实例引导队列与接纳进度",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "MESSAGES": {
          "plugin": "runtime",
          "id": "org.aurora.bot:state/messages",
          "kind": "state_key",
          "summary": "实例交流上下文",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "RUN": {
          "plugin": "runtime",
          "id": "org.aurora.bot:state/run",
          "kind": "state_key",
          "summary": "实例运行状态",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "WORK": {
          "plugin": "runtime",
          "id": "org.aurora.bot:state/react_work",
          "kind": "state_key",
          "summary": "按运行隔离的产品工作状态",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "PREPARE": {
          "plugin": "runtime",
          "id": "org.aurora.bot:handlers/runtime/prepare",
          "kind": "hook_handler",
          "summary": "将恢复的未完成状态标记为中断",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "START": {
          "plugin": "runtime",
          "id": "org.aurora.bot:handlers/runtime/start",
          "kind": "hook_handler",
          "summary": "启动自有调度器并绑定运行操作",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "STOP": {
          "plugin": "runtime",
          "id": "org.aurora.bot:handlers/runtime/stop",
          "kind": "hook_handler",
          "summary": "等待自有运行结束并裁剪工作状态",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "CLEAN": {
          "plugin": "runtime",
          "id": "org.aurora.bot:handlers/runtime/clean",
          "kind": "hook_handler",
          "summary": "解除本实例的运行操作绑定",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        }
      },
      "components": {
        "operations": {
          "inject": ["registry"],
          "plugs": [],
          "slots": [],
          "states": [],
          "optional_states": [],
          "inputs": [],
          "optional_inputs": [],
          "resources": ["operations"],
          "plugin": "runtime"
        },
        "runtime": {
          "inject": ["ctx", "instance_id", "states", "options"],
          "plugs": ["PREPARE", "START", "STOP", "CLEAN"],
          "slots": [],
          "states": ["context", "model_output", "tool_output", "work"],
          "optional_states": [],
          "inputs": ["agent", "operations"],
          "optional_inputs": [],
          "resources": ["runtime", "owner"],
          "options": "owner",
          "plugin": "runtime"
        }
      },
      "contracts": {
        "owner": {
          "format": "json-schema",
          "file": "owner.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner"],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
