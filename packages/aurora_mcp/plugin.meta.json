{
  "schema_version": 2,
  "distribution": {
    "name": "aurora-mcp",
    "version": "0.1.0",
    "description": "Aurora MCP clients and optional tool/world bridges",
    "requires-python": ">=3.12",
    "dependencies": ["aurora-core>=0.1.0", "aurora-config>=0.1.0", "mcp==2.3.0", "httpx2>=2.16,<3", "anyio>=4.15,<5"],
    "optional-dependencies": {
      "tools": ["aurora-tools>=0.1.0"],
      "world": ["aurora-world[config]>=0.1.0"]
    },
    "entry-points": {
      "aurora.plugins": {
        "aurora_mcp": "aurora_mcp:plugin",
        "aurora_mcp.world": "aurora_mcp.world:plugin",
        "aurora_mcp.tools": "aurora_mcp.tools:plugin"
      }
    }
  },
  "manifests": {
    "src/aurora_mcp/plugins/clients/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "clients": {
          "entry_point": "aurora_mcp",
          "title": "MCP 客户端",
          "summary": "MCP 客户端的公开定义与真实实例导出",
          "requires": ["aurora_config"],
          "factory": "aurora_mcp:plugin"
        }
      },
      "definitions": {
        "CONFIGURATION": {
          "plugin": "clients",
          "id": "org.aurora.mcp:configs/default",
          "kind": "config",
          "summary": "MCP 连接和目录筛选配置",
          "contract": "configuration",
          "register_to": {
            "id": "org.aurora.config:registries/configs"
          }
        },
        "CONFIG_STATE": {
          "plugin": "clients",
          "id": "org.aurora.mcp:state/config",
          "kind": "state_key",
          "summary": "非持久的 MCP 配置",
          "register_to": {
            "id": "org.aurora.core:registries/state_keys"
          }
        },
        "CLIENT_STATUS": {
          "plugin": "clients",
          "id": "org.aurora.mcp:state/clients",
          "kind": "state_key",
          "summary": "MCP 连接观察状态"
        },
        "CONFIGURE": {
          "plugin": "clients",
          "id": "org.aurora.mcp:handlers/configure",
          "kind": "hook_handler",
          "summary": "选择配置的 MCP 连接",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "PREPARE": {
          "plugin": "clients",
          "id": "org.aurora.mcp:handlers/prepare",
          "kind": "hook_handler",
          "summary": "准备阶段端口",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "STOP": {
          "plugin": "clients",
          "id": "org.aurora.mcp:handlers/stop",
          "kind": "hook_handler",
          "summary": "停止接收并等待借用者结束",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        },
        "CLEAN": {
          "plugin": "clients",
          "id": "org.aurora.mcp:handlers/clean",
          "kind": "hook_handler",
          "summary": "关闭所有者创建的连接",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        }
      },
      "components": {
        "clients": {
          "plugin": "clients",
          "inject": ["ctx", "hooks", "instance_id", "workspace_root", "resolve_credential"],
          "plugs": ["CONFIGURE", "PREPARE", "STOP", "CLEAN"],
          "slots": [],
          "resources": ["clients"]
        }
      },
      "contracts": {
        "configuration": {
          "format": "json-schema",
          "file": "config.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version"],
            "properties": {
              "schema_version": {
                "type": "integer",
                "const": 2
              },
              "timeout": {
                "type": "object",
                "additionalProperties": false,
                "default": {},
                "properties": {
                  "startup": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 300
                  },
                  "catalog": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3600
                  },
                  "execution": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 43200
                  },
                  "shutdown": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 300
                  }
                }
              },
              "servers": {
                "type": "object",
                "default": {},
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "enum": ["remote", "local"]
                    },
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "protocol": {
                      "enum": ["legacy", "auto", "2026-07-28"],
                      "default": "legacy"
                    },
                    "required_capabilities": {
                      "type": "array",
                      "uniqueItems": true,
                      "default": [],
                      "items": {
                        "enum": ["tools", "resources", "prompts", "completions"]
                      }
                    },
                    "timeout": {
                      "type": "object",
                      "additionalProperties": false,
                      "default": {},
                      "properties": {
                        "startup": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 300
                        },
                        "catalog": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 3600
                        },
                        "execution": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 43200
                        },
                        "shutdown": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 300
                        }
                      }
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headers": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "oauth": {},
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "cwd": {
                      "type": "string",
                      "minLength": 1
                    },
                    "environment": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "tools": {
                      "type": "object",
                      "additionalProperties": false,
                      "default": {},
                      "properties": {
                        "include": {
                          "type": "array",
                          "uniqueItems": true,
                          "default": ["*"],
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "exclude": {
                          "type": "array",
                          "uniqueItems": true,
                          "default": [],
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "not": {
                              "const": "*"
                            }
                          }
                        },
                        "aliases": {
                          "type": "object",
                          "default": {},
                          "propertyNames": {
                            "minLength": 1,
                            "not": {
                              "const": "*"
                            }
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])",
                            "maxLength": 64
                          }
                        }
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "remote"
                          }
                        }
                      },
                      "then": {
                        "required": ["url"],
                        "properties": {
                          "command": false,
                          "cwd": false,
                          "environment": false
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "local"
                          }
                        }
                      },
                      "then": {
                        "required": ["command"],
                        "properties": {
                          "url": false,
                          "headers": false,
                          "oauth": false
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "src/aurora_mcp/plugins/tools/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "tools": {
          "entry_point": "aurora_mcp.tools",
          "title": "MCP 工具目录",
          "summary": "MCP 工具目录的公开定义与真实实例导出",
          "requires": ["aurora_mcp", "aurora_tools"],
          "factory": "aurora_mcp.tools:plugin"
        }
      },
      "definitions": {
        "COMPONENT": {
          "plugin": "tools",
          "id": "org.aurora.mcp:components/tool",
          "kind": "component",
          "summary": "单个 MCP 工具执行组件"
        },
        "EXECUTE": {
          "plugin": "tools",
          "id": "org.aurora.mcp:components/tool/execute",
          "kind": "hook_handler",
          "summary": "执行实例的一次调用",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          },
          "interface": {
            "definition": {
              "id": "org.aurora.mcp:components/tool"
            }
          }
        },
        "PREPARE": {
          "plugin": "tools",
          "id": "org.aurora.mcp:handlers/tools/prepare",
          "kind": "hook_handler",
          "summary": "准备阶段端口",
          "register_to": {
            "id": "org.aurora.core:registries/hook_handlers"
          }
        }
      },
      "components": {
        "catalog": {
          "plugin": "tools",
          "inject": ["ctx", "registry", "hooks", "instance_id"],
          "plugs": ["PREPARE"],
          "slots": [],
          "inputs": ["clients"],
          "resources": ["catalog"]
        }
      },
      "dynamic": {
        "TOOL_DEFINITIONS": {
          "plugin": "tools",
          "kind": "tool",
          "id_root": "org.aurora.mcp:tools",
          "summary": "prepare 发现的工具目录；集合显式选择后创建实际成员",
          "register_to": {
            "id": "org.aurora.tools:registries/tools"
          }
        }
      }
    },
    "src/aurora_mcp/plugins/world/plugin.meta.toml": {
      "schema_version": 2,
      "plugins": {
        "world": {
          "entry_point": "aurora_mcp.world",
          "title": "MCP 世界来源",
          "summary": "MCP 世界来源的公开定义与真实实例导出",
          "requires": ["aurora_mcp", "aurora_world.sources"],
          "factory": "aurora_mcp.world:plugin"
        }
      },
      "definitions": {
        "WORLD_SOURCE": {
          "plugin": "world",
          "id": "org.aurora.mcp:sources/resources",
          "kind": "source",
          "summary": "MCP 资源更新的世界来源工厂",
          "contract": "source",
          "register_to": {
            "id": "org.aurora.world:registries/sources"
          }
        },
        "WORLD_STATUS": {
          "plugin": "world",
          "id": "org.aurora.mcp:state/world",
          "kind": "state_key",
          "summary": "MCP 世界来源的非持久观察状态"
        }
      },
      "components": {
        "source_resources": {
          "plugin": "world",
          "inject": ["ctx"],
          "plugs": [],
          "slots": [],
          "inputs": ["clients"],
          "resources": ["resources"]
        }
      },
      "contracts": {
        "source": {
          "format": "json-schema",
          "file": "config.schema.json",
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["connection_id", "resources"],
            "properties": {
              "connection_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["uri"],
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["notification", "resource", "event"],
                      "default": "resource"
                    }
                  }
                }
              },
              "watch_tools": {
                "type": "boolean",
                "default": false
              },
              "buffer_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096,
                "default": 64
              },
              "max_content_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216,
                "default": 1048576
              }
            }
          }
        }
      }
    }
  }
}
