{
  "type": "object",
  "additionalProperties": false,
  "required": ["connection_id", "resources"],
  "properties": {
    "connection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "mode": {
            "type": "string",
            "enum": ["notification", "resource", "event"],
            "default": "resource"
          }
        }
      }
    },
    "watch_tools": {
      "type": "boolean",
      "default": false
    },
    "buffer_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 64
    },
    "max_content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216,
      "default": 1048576
    }
  }
}
