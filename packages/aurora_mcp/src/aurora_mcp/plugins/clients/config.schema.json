{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "startup": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "catalog": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "execution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 43200
        },
        "shutdown": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        }
      }
    },
    "servers": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["remote", "local"]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "protocol": {
            "enum": ["legacy", "auto", "2026-07-28"],
            "default": "legacy"
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "default": [],
            "items": {
              "enum": ["tools", "resources", "prompts", "completions"]
            }
          },
          "timeout": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "startup": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "catalog": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "execution": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 43200
              },
              "shutdown": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              }
            }
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "oauth": {},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "tools": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "include": {
                "type": "array",
                "uniqueItems": true,
                "default": ["*"],
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "type": "array",
                "uniqueItems": true,
                "default": [],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "const": "*"
                  }
                }
              },
              "aliases": {
                "type": "object",
                "default": {},
                "propertyNames": {
                  "minLength": 1,
                  "not": {
                    "const": "*"
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])",
                  "maxLength": 64
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remote"
                }
              }
            },
            "then": {
              "required": ["url"],
              "properties": {
                "command": false,
                "cwd": false,
                "environment": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "local"
                }
              }
            },
            "then": {
              "required": ["command"],
              "properties": {
                "url": false,
                "headers": false,
                "oauth": false
              }
            }
          }
        ]
      }
    }
  }
}
