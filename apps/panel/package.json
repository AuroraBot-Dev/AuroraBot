{
  "name": "@aurorabot/panel",
  "version": "5.7.0",
  "private": true,
  "homepage": "https://github.com/AuroraBot-Dev/panel",
  "bugs": "https://github.com/AuroraBot-Dev/panel/issues",
  "repository": {
    "type": "git",
