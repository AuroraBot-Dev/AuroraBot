{
  "name": "@aurorabot/landing",
  "version": "0.7.0",
  "description": "AuroraBot 落地页",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "pnpm --dir ../.. lint all",
    "test": "pnpm --dir ../.. test landing",
    "clean": "rimraf dist node_modules/.vite node_modules/.vitepress .vitepress/.temp .vitepress/cache"
  },
  "dependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vben/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
