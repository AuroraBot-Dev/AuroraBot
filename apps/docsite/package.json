{
  "name": "@aurorabot/docsite",
  "version": "0.7.0",
  "description": "AuroraBot 文档站",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev . --host 0.0.0.0 --port 5173",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "pnpm --dir ../.. lint all",
    "test": "pnpm --dir ../.. test docsite",
    "clean": "rimraf dist node_modules/.vite node_modules/.vitepress .vitepress/.temp .vitepress/cache"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "catalog:",
    "@types/node": "catalog:",
    "@vben/tsconfig": "workspace:*",
    "mermaid": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-mermaid": "catalog:",
    "vitepress-sidebar": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
